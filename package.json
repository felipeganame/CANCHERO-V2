{
  "name": "canchero",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit --project components",
    "test:unit": "vitest run --project unit --project components",
    "test:int": "vitest run --project integration",
    "test:int:qa": "vitest run -c vitest.integration-qa.config.ts",
    "test:api": "vitest run --project api",
    "test:e2e": "playwright test --project e2e",
    "test:smoke": "playwright test --project smoke",
    "test:stress": "k6 run tests/load/booking-race.js",
    "test:load": "k6 run tests/load/search.js",
    "test:soak": "k6 run tests/load/soak.js",
    "test:all": "pnpm test:unit && pnpm test:int && pnpm test:api",
    "coverage": "vitest run --coverage",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:seed": "node --env-file=.env.local --import tsx src/server/db/seed.ts",
    "db:seed:e2e": "node --import tsx src/server/db/seed-e2e.ts"
  },
  "dependencies": {
    "next": "15.5.28",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "drizzle-orm": "^0.45.4",
    "postgres": "^3.4.5",
    "zod": "^4.0.0",
    "better-auth": "^1.2.7",
    "resend": "^4.1.1",
    "lucide-react": "^0.468.0",
    "@radix-ui/react-dialog": "^1.1.4",
    "@radix-ui/react-tabs": "^1.1.2",
    "@radix-ui/react-select": "^2.1.4",
    "leaflet": "^1.9.4",
    "react-leaflet": "^5.0.0"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@types/leaflet": "^1.9.14",
    "tailwindcss": "^3.4.17",
    "postcss": "^8.4.49",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.17.0",
    "eslint-config-next": "15.5.28",
    "@eslint/eslintrc": "^3.2.0",
    "vitest": "^3.2.4",
    "@vitest/coverage-v8": "^3.2.4",
    "@vitejs/plugin-react": "^4.3.4",
    "@testing-library/react": "^16.1.0",
    "@playwright/test": "^1.49.1",
    "drizzle-kit": "^0.31.1",
    "@testcontainers/postgresql": "^10.16.0",
    "dotenv": "^16.4.7",
    "tsx": "^4.19.2",
    "jsdom": "^25.0.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/user-event": "^14.5.2"
  },
  "packageManager": "pnpm@10.19.0"
}
