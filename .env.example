# Base de datos (local Postgres para dev, Supabase para preview/prod).
# En Vercel (preview/prod) usar el pooler de Supabase en MODO TRANSACCION
# (puerto 6543, con ?pgbouncer=true) - no modo sesion (5432), que se agota
# rapido bajo carga serverless concurrente (ver DEF-04 en docs/defectos.md).
DATABASE_URL="postgresql://localhost:5432/canchero"

# Supabase (preview/prod)
SUPABASE_URL="https://zmaogbldmtivospebwxr.supabase.co"
SUPABASE_ANON_KEY=""

# Auth
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Solo en test/preview: habilita login por email/contraseña con usuario sembrado.
AUTH_TEST_LOGIN="true"

# Resend (emails: confirmación de registro, confirmación de reserva)
RESEND_API_KEY=""
RESEND_FROM="Canchero <onboarding@resend.dev>"

# IA (Genkit + Gemini) — [DECIDIR uso]
GEMINI_API_KEY=""
